<div class="toast-wrap" id="toastWrap" aria-live="polite"></div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
(function () {
    var tokenEl = document.querySelector('#afForm input[name="__RequestVerificationToken"]');
    var token = tokenEl ? tokenEl.value : '';
    var toggleUrl = '@Url.Action("Toggle", "Wishlist")';
    var wishlistUrl = '@Url.Action("Index", "Wishlist")';

    window.showToast = function (msg, link, linkText) {
        var wrap = document.getElementById('toastWrap');
        var t = document.createElement('div');
        t.className = 'sm-toast';
        t.textContent = msg + ' ';
        if (link) { var a = document.createElement('a'); a.href = link; a.textContent = linkText; t.appendChild(a); }
        wrap.appendChild(t);
        setTimeout(function () { t.classList.add('show'); }, 10);
        setTimeout(function () { t.classList.remove('show'); setTimeout(function () { t.remove(); }, 300); }, 3200);
    };

    function setCount(n) {
        document.querySelectorAll('[data-wish-count]').forEach(function (el) {
            el.textContent = n;
            el.style.display = n > 0 ? '' : 'none';
        });
    }

    function paint(id, liked) {
        document.querySelectorAll('[data-wish="' + id + '"]').forEach(function (b) {
            b.classList.toggle('active', liked);
            b.setAttribute('aria-pressed', liked ? 'true' : 'false');
            var i = b.querySelector('i');
            if (i) { i.classList.toggle('fa-solid', liked); i.classList.toggle('fa-regular', !liked); }
            var txt = b.querySelector('.wish-text');
            if (txt) txt.textContent = liked ? 'Wishlisted' : 'Add to Wishlist';
        });
    }

    document.addEventListener('click', function (e) {
        var b = e.target.closest('[data-wish]');
        if (!b) return;
        e.preventDefault();
        if (b.dataset.busy) return;
        b.dataset.busy = '1';
        var id = b.getAttribute('data-wish');

        fetch(toggleUrl, {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-CSRF-TOKEN': token },
            body: 'id=' + encodeURIComponent(id)
        })
        .then(function (r) { if (!r.ok) throw new Error('bad'); return r.json(); })
        .then(function (d) {
            if (!d.ok) { showToast(d.message); return; }
            paint(id, d.added);
            setCount(d.count);
            showToast(d.message, d.added ? wishlistUrl : null, 'View wishlist');

            // Fire a custom event so the wishlist page can react
            document.dispatchEvent(new CustomEvent('wishlist:toggled', { detail: { id: id, added: d.added } }));

            if (!d.added && document.body.dataset.page === 'wishlist-index') {
                var col = b.closest('.wish-col');
                if (col) {
                    col.classList.add('wish-removing');
                    setTimeout(function () {
                        col.remove();
                        if (!document.querySelector('.wish-col')) location.reload();
                    }, 250);
                }
            }
        })
        .catch(function () { showToast('Something went wrong. Please try again.'); })
        .finally(function () { delete b.dataset.busy; });
    });
})();
</script>
@await RenderSectionAsync("Scripts", required: false)
</body></html>
