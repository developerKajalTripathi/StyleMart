@inject StyleMart.Services.CartService CartSvc
@inject StyleMart.Services.WishlistService WishSvc
@inject StyleMart.Data.StyleMartContext Db

@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Identity
@using StyleMart.Models
@inject UserManager<ApplicationUser> UserManager



@{
    int cartCount = 0, wishCount = 0;
    try { cartCount = await CartSvc.CountAsync(); } catch { }
    try { wishCount = await WishSvc.CountAsync(); } catch { }
    var categoryNames = new List<string>();
    try { categoryNames = await Db.Categories.OrderBy(c => c.Name).Select(c => c.Name).ToListAsync(); } catch { }

    var isAuth = User.Identity?.IsAuthenticated == true;
    var isAdmin = isAuth && User.IsInRole("Admin");

   // var shortName = (User.Identity?.Name ?? "").Split('@')[0];

   
        var shortName = (User.Identity?.Name ?? "").Split('@')[0];

        if (User.Identity?.IsAuthenticated == true)
        {
            var loggedInUser = await UserManager.GetUserAsync(User);

            if (!string.IsNullOrWhiteSpace(loggedInUser?.FullName))
            {
                shortName = loggedInUser.FullName;
            }
        }

    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var act = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var activeCat = Context.Request.Query["category"].ToString();

    string Active(bool on) => on ? "active" : "";
    bool onShopAll = ctrl == "Products" && act == "Index" && string.IsNullOrEmpty(activeCat);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StyleMart</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />





</head>
<body data-page="@(ctrl.ToLower())-@(act.ToLower())">
<header class="sticky-top">
<nav class="navbar navbar-expand-lg navbar-dark main-nav">
 <div class="container">
  <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index"><i class="fa-solid fa-bag-shopping me-2"></i>StyleMart</a>

  <div class="d-flex align-items-center gap-3 order-lg-last ms-auto me-2 me-lg-0 nav-icons">
   <a class="nav-icon-link" asp-controller="Wishlist" asp-action="Index" title="Wishlist">
    <i class="fa-regular fa-heart"></i><span class="d-none d-xl-inline ms-1">Wishlist</span>
    <span class="badge rounded-pill bg-danger nav-badge" data-wish-count style="@(wishCount > 0 ? "" : "display:none")">@wishCount</span>
   </a>
   <a class="nav-icon-link" asp-controller="Cart" asp-action="Index" title="Cart">
    <i class="fa-solid fa-cart-shopping"></i><span class="d-none d-xl-inline ms-1">Cart</span>
    @if (cartCount > 0) {<span class="badge rounded-pill bg-danger nav-badge">@cartCount</span>}
   </a>
  </div>

  <button class="navbar-toggler ms-2" type="button" data-bs-toggle="collapse" data-bs-target="#nav" aria-label="Menu"><span class="navbar-toggler-icon"></span></button>

  <div class="collapse navbar-collapse" id="nav">
   <ul class="navbar-nav me-auto">
    <li class="nav-item"><a class="nav-link @Active(ctrl == "Home")" asp-controller="Home" asp-action="Index">Home</a></li>
    <li class="nav-item"><a class="nav-link @Active(onShopAll)" asp-controller="Products" asp-action="Index">Shop All</a></li>
    <li class="nav-item dropdown">
     <a class="nav-link dropdown-toggle @Active(ctrl == "Products" && !string.IsNullOrEmpty(activeCat))" href="#" role="button" data-bs-toggle="dropdown">Categories</a>
     <ul class="dropdown-menu">
      @foreach (var c in categoryNames)
      {
       <li><a class="dropdown-item @Active(activeCat == c)" asp-controller="Products" asp-action="Index" asp-route-category="@c">@c</a></li>
      }
      @if (categoryNames.Count > 0) {<li><hr class="dropdown-divider"></li>}
      <li><a class="dropdown-item" asp-controller="Products" asp-action="Index">All products</a></li>
     </ul>
    </li>
    <li class="nav-item"><a class="nav-link @Active(activeCat == "Women")" asp-controller="Products" asp-action="Index" asp-route-category="Women">Women</a></li>
    <li class="nav-item"><a class="nav-link @Active(activeCat == "Men")" asp-controller="Products" asp-action="Index" asp-route-category="Men">Men</a></li>
    <li class="nav-item dropdown">
     <a class="nav-link dropdown-toggle @Active(ctrl == "Info")" href="#" role="button" data-bs-toggle="dropdown">Help</a>
     <ul class="dropdown-menu">
      <li><a class="dropdown-item" asp-controller="Info" asp-action="About"><i class="fa fa-store me-2"></i>About us</a></li>
      <li><a class="dropdown-item" asp-controller="Info" asp-action="Help"><i class="fa fa-circle-question me-2"></i>Help &amp; FAQs</a></li>
      <li><a class="dropdown-item" asp-controller="Info" asp-action="Contact"><i class="fa fa-headset me-2"></i>Contact us</a></li>
     </ul>
    </li>
   </ul>

   <form class="d-flex me-lg-3 my-2 my-lg-0" asp-controller="Products" asp-action="Index" method="get">
    <input class="form-control form-control-sm" name="search" placeholder="Search styles..." />
    <button class="btn btn-pink btn-sm ms-1" aria-label="Search"><i class="fa fa-search"></i></button>
   </form>

   @if (isAuth)
   {
    <div class="dropdown">
     <a class="nav-link text-white dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown"><i class="fa-solid fa-user"></i> @shortName</a>
     <ul class="dropdown-menu dropdown-menu-end">
      <li><a class="dropdown-item" asp-controller="Account" asp-action="MyOrders"><i class="fa fa-box me-2"></i>My Orders</a></li>
      <li><a class="dropdown-item" asp-controller="Wishlist" asp-action="Index"><i class="fa fa-heart me-2"></i>My Wishlist</a></li>
      <li><a class="dropdown-item" asp-controller="Cart" asp-action="Index"><i class="fa fa-cart-shopping me-2"></i>My Cart</a></li>
      @if (isAdmin)
      {
       <li><hr class="dropdown-divider"></li>
       <li><h6 class="dropdown-header">Admin</h6></li>
       <li><a class="dropdown-item" asp-controller="Admin" asp-action="Index"><i class="fa-solid fa-chart-line me-2"></i>Dashboard</a></li>
       <li><a class="dropdown-item" asp-controller="Admin" asp-action="Products"><i class="fa fa-shirt me-2"></i>Products</a></li>
       <li><a class="dropdown-item" asp-controller="Admin" asp-action="Categories"><i class="fa fa-tags me-2"></i>Categories</a></li>
       <li><a class="dropdown-item" asp-controller="Admin" asp-action="ProductVariants"><i class="fa fa-palette me-2"></i>Variants</a></li>
       <li><a class="dropdown-item" asp-controller="Admin" asp-action="Orders"><i class="fa fa-clipboard-list me-2"></i>Orders</a></li>
       <li><a class="dropdown-item" asp-controller="Admin" asp-action="Reviews"><i class="fa fa-star me-2"></i>Reviews</a></li>
      }
      <li><hr class="dropdown-divider"></li>
      <li><form asp-controller="Account" asp-action="Logout" method="post"><button class="dropdown-item"><i class="fa fa-right-from-bracket me-2"></i>Logout</button></form></li>
     </ul>
    </div>
   }
   else
   {
    <a class="nav-link text-white me-2" asp-controller="Account" asp-action="Login"><i class="fa-solid fa-user"></i> Login</a>
    <a class="btn btn-pink btn-sm" asp-controller="Account" asp-action="Register">Sign up</a>
   }
  </div>
 </div>
</nav>
</header>

<form id="afForm" class="d-none">@Html.AntiForgeryToken()</form>

<main>

        @if (TempData["Message"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show m-3"
                 role="alert">
                <i class="fa-solid fa-circle-check me-2"></i>
                @TempData["Message"]

                <button type="button" class="btn-close"
                        data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["InfoMessage"] != null)
        {
            <div class="alert alert-info alert-dismissible fade show m-3"
                 role="alert">
                <i class="fa-solid fa-circle-info me-2"></i>
                @TempData["InfoMessage"]

                <button type="button" class="btn-close"
                        data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show m-3"
                 role="alert">
                <i class="fa-solid fa-circle-exclamation me-2"></i>
                @TempData["Error"]

                <button type="button" class="btn-close"
                        data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

    
    @RenderBody()</main>

