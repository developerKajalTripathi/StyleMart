@model Order
@{ ViewData["Title"] = "Order confirmed – " + Model.OrderNumber; }

<style>
    .confirm-wrap {
        max-width: 820px;
        margin: 40px auto;
        padding: 0 16px 60px;
    }

    .confirm-success-box {
        background: linear-gradient(135deg, #e8f5e9, #f1fff2);
        border: 1.5px solid #a5d6a7;
        border-radius: 18px;
        padding: 28px 30px;
        display: flex;
        align-items: center;
        gap: 20px;
        margin-bottom: 28px;
    }

    .tick-circle {
        width: 60px;
        height: 60px;
        background: #16803c;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        font-size: 28px;
        color: white;
        box-shadow: 0 4px 18px rgba(22,128,60,.3);
    }

    .confirm-title { font-size: 22px; font-weight: 800; color: #16803c; }
    .confirm-sub { color: #555; font-size: 14px; margin-top: 2px; }
    .order-no-pill {
        background: #e8f5e9;
        border: 1px solid #a5d6a7;
        border-radius: 20px;
        padding: 3px 12px;
        font-size: 13px;
        font-weight: 700;
        color: #16803c;
        display: inline-block;
        margin-top: 5px;
    }

    /* ---- Flipkart-style tracking bar ---- */
    .tracking-card {
        background: white;
        border: 1.5px solid #f2dce7;
        border-radius: 18px;
        padding: 24px 28px;
        margin-bottom: 22px;
        box-shadow: 0 6px 24px rgba(130,45,85,.07);
    }

    .tracking-card h5 { font-weight: 700; color: #30232b; margin-bottom: 20px; }

    .track-steps {
        display: flex;
        align-items: flex-start;
        gap: 0;
        position: relative;
        overflow-x: auto;
        padding-bottom: 10px;
    }

    .track-step {
        display: flex;
        flex-direction: column;
        align-items: center;
        flex: 1;
        min-width: 90px;
        position: relative;
        z-index: 1;
    }

    .track-step::before {
        content: '';
        position: absolute;
        top: 18px;
        left: 50%;
        width: 100%;
        height: 3px;
        background: #e9ecef;
        z-index: 0;
    }

    .track-step:last-child::before { display: none; }

    .track-step.done::before { background: #e83e8c; }
    .track-step.active::before { background: linear-gradient(90deg, #e83e8c, #e9ecef); }

    .step-dot {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: #e9ecef;
        border: 3px solid #dee2e6;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 15px;
        position: relative;
        z-index: 2;
        transition: all .3s;
    }

    .track-step.done .step-dot {
        background: #e83e8c;
        border-color: #e83e8c;
        color: white;
        box-shadow: 0 3px 12px rgba(232,62,140,.35);
    }

    .track-step.active .step-dot {
        background: white;
        border-color: #e83e8c;
        color: #e83e8c;
        box-shadow: 0 3px 12px rgba(232,62,140,.2);
        animation: pulse-dot 1.5s infinite;
    }

    @@keyframes pulse-dot {
        0%, 100% { box-shadow: 0 0 0 0 rgba(232,62,140,.4); }
        50% { box-shadow: 0 0 0 8px rgba(232,62,140,.0); }
    }

    .step-label {
        font-size: 11px;
        font-weight: 600;
        color: #999;
        margin-top: 8px;
        text-align: center;
        max-width: 85px;
    }
    .track-step.done .step-label,
    .track-step.active .step-label { color: #e83e8c; }

    .step-date {
        font-size: 10px;
        color: #bbb;
        margin-top: 2px;
        text-align: center;
    }
    .track-step.done .step-date { color: #555; }

    /* Expected delivery pill */
    .delivery-pill {
        background: #fff0f8;
        border: 1.5px solid #f2dce7;
        border-radius: 12px;
        padding: 10px 16px;
        display: flex;
        align-items: center;
        gap: 10px;
        margin-top: 18px;
    }
    .delivery-pill .dp-icon { font-size: 22px; }
    .delivery-pill .dp-label { font-size: 12px; color: #888; }
    .delivery-pill .dp-date { font-size: 16px; font-weight: 800; color: #e83e8c; }

    /* Order details card */
    .detail-card {
        background: white;
        border: 1.5px solid #f2dce7;
        border-radius: 18px;
        padding: 24px 28px;
        margin-bottom: 22px;
        box-shadow: 0 6px 24px rgba(130,45,85,.07);
    }

    .detail-card h5 { font-weight: 700; color: #30232b; margin-bottom: 16px; }

    .detail-row {
        display: flex;
        justify-content: space-between;
        padding: 8px 0;
        border-bottom: 1px solid #f9f0f5;
        font-size: 14px;
    }
    .detail-row:last-child { border-bottom: none; }
    .detail-row .dr-label { color: #777; }
    .detail-row .dr-value { font-weight: 600; color: #222; text-align: right; }

    .item-thumb {
        width: 56px;
        height: 64px;
        object-fit: cover;
        border-radius: 8px;
        border: 1px solid #f0dde8;
    }

    .action-btns {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        margin-top: 8px;
    }

    .btn-pink-outline {
        border: 2px solid #e83e8c;
        color: #e83e8c;
        background: white;
        border-radius: 10px;
        padding: 10px 22px;
        font-weight: 700;
        font-size: 14px;
        text-decoration: none;
        transition: background .2s, color .2s;
    }
    .btn-pink-outline:hover { background: #e83e8c; color: white; }
    .btn-shop {
        background: #e83e8c;
        color: white;
        border: none;
        border-radius: 10px;
        padding: 10px 22px;
        font-weight: 700;
        font-size: 14px;
        text-decoration: none;
        transition: background .2s;
    }
    .btn-shop:hover { background: #c92c74; color: white; }

    /* Payment badge */
    .pay-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #e8f5e9;
        border: 1px solid #a5d6a7;
        border-radius: 20px;
        padding: 3px 12px;
        font-size: 12px;
        font-weight: 700;
        color: #16803c;
    }

    @@media (max-width: 576px) {
        .confirm-success-box { flex-direction: column; text-align: center; }
        .track-steps { gap: 0; }
        .step-label { font-size: 10px; max-width: 65px; }
    }
</style>

<div class="confirm-wrap">

    <!-- Success banner -->
    <div class="confirm-success-box">
        <div class="tick-circle">✓</div>
        <div>
            <div class="confirm-title">Order Placed Successfully!</div>
            <div class="confirm-sub">Thank you for shopping with StyleMart 🎉</div>
            <span class="order-no-pill">Order #@Model.OrderNumber</span>
        </div>
    </div>

    <!-- Tracking card -->
    <div class="tracking-card">
        <h5>📦 Order Tracking</h5>

        @{
            var steps = new[]
            {
                ("Order Placed", "🛒", "Processing", Model.CreatedAt),
                ("Order Confirmed", "✅", "Confirmed",  (DateTime?)null),
                ("Shipped", "🚚", "Shipped", Model.ShippedAt),
                ("Out for Delivery", "🏃", "Out for Delivery", Model.OutForDeliveryAt),
                ("Delivered", "🏠", "Delivered", Model.DeliveredAt)
            };

            var statusOrder = new[] { "Processing", "Confirmed", "Shipped", "Out for Delivery", "Delivered" };
            var currentIdx = Array.IndexOf(statusOrder, Model.Status);
            if (currentIdx < 0) currentIdx = 0;
        }

        <div class="track-steps">
            @for (int i = 0; i < steps.Length; i++)
            {
                var (label, icon, statusKey, dt) = steps[i];
                string cls = i < currentIdx ? "done" : (i == currentIdx ? "active" : "");
                <div class="track-step @cls">
                    <div class="step-dot">@(i <= currentIdx ? icon : "○")</div>
                    <div class="step-label">@label</div>
                    <div class="step-date">
                        @if (dt.HasValue) { @dt.Value.ToString("dd MMM, hh:mm tt") }
                        else if (i == 0) { @Model.CreatedAt.ToString("dd MMM, hh:mm tt") }
                    </div>
                </div>
            }
        </div>

        @if (Model.Status == "Cancelled")
        {
            <div class="alert alert-danger mt-3 mb-0">❌ This order has been cancelled.</div>
        }
        else
        {
            <div class="delivery-pill">
                <span class="dp-icon">📅</span>
                <div>
                    <div class="dp-label">Expected Delivery</div>
                    <div class="dp-date">
                        @(Model.DeliveredAt.HasValue
                            ? "✅ Delivered on " + Model.DeliveredAt.Value.ToString("dd MMM yyyy")
                            : Model.ExpectedDeliveryDate.HasValue
                                ? Model.ExpectedDeliveryDate.Value.ToString("dddd, dd MMM yyyy")
                                : "In 5–7 business days")
                    </div>
                </div>
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.TrackingMessage))
        {
            <div class="alert alert-info mt-3 mb-0" style="border-radius:10px;font-size:13px;">
                📍 @Model.TrackingMessage
            </div>
        }
    </div>

    <!-- Order Details -->
    <div class="detail-card">
        <h5>🧾 Order Details</h5>
        <div class="detail-row">
            <span class="dr-label">Order Number</span>
            <span class="dr-value">#@Model.OrderNumber</span>
        </div>
        <div class="detail-row">
            <span class="dr-label">Order Date</span>
            <span class="dr-value">@Model.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</span>
        </div>
        <div class="detail-row">
            <span class="dr-label">Deliver to</span>
            <span class="dr-value">@Model.CustomerName · @Model.Phone</span>
        </div>
        <div class="detail-row">
            <span class="dr-label">Address</span>
            <span class="dr-value" style="max-width:260px;">@Model.Address</span>
        </div>
        @if (!string.IsNullOrEmpty(Model.DetectedCity))
        {
            <div class="detail-row">
                <span class="dr-label">📍 Location at Order</span>
                <span class="dr-value">@Model.DetectedCity</span>
            </div>
        }
        <div class="detail-row">
            <span class="dr-label">Payment Method</span>
            <span class="dr-value">
                @(Model.PaymentMethod == "COD" ? "💵 Cash on Delivery" : "💳 " + Model.PaymentMethod)
            </span>
        </div>
        <div class="detail-row">
            <span class="dr-label">Payment Status</span>
            <span class="dr-value">
                <span class="pay-badge">
                    @(Model.PaymentStatus == "Paid" ? "✓" : "⏳") @Model.PaymentStatus
                </span>
            </span>
        </div>
        <div class="detail-row">
            <span class="dr-label">Total Amount</span>
            <span class="dr-value" style="color:#e83e8c;font-size:18px;">₹@Model.Total.ToString("N0")</span>
        </div>
    </div>

    <!-- Items ordered -->
    <div class="detail-card">
        <h5>🛍️ Items Ordered</h5>
        @foreach (var item in Model.Items)
        {
            <div class="d-flex align-items-center gap-3 py-3 border-bottom">
                <img src="@item.ImageUrl" class="item-thumb" alt=""
                     onerror="this.onerror=null;this.src='https://placehold.co/56x64/f5f0ed/222?text=SM'">
                <div class="flex-grow-1">
                    <div class="fw-semibold">@item.ProductName</div>
                    @if (!string.IsNullOrEmpty(item.VariantInfo))
                    {
                        <div class="small text-muted">@item.VariantInfo</div>
                    }
                    <div class="small text-muted">Qty: @item.Quantity</div>
                </div>
                <div class="text-end">
                    <div class="fw-bold">₹@item.LineTotal.ToString("N0")</div>
                    <div class="small text-muted" style="text-decoration:line-through;">₹@((item.Mrp * item.Quantity).ToString("N0"))</div>
                </div>
            </div>
        }
    </div>

    <!-- Action buttons -->
    <div class="action-btns">
        <a asp-controller="Account" asp-action="MyOrders" class="btn-pink-outline">📦 My Orders</a>
        <a asp-controller="Products" asp-action="Index" class="btn-shop">🛍️ Continue Shopping</a>
    </div>
</div>
