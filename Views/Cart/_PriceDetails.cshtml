@model CartViewModel
<div class="summary-card">
	<h5>Price details</h5>



	@foreach (var l in Model.Lines)
	{
		<div class="d-flex justify-content-between small my-2">
			<span>@l.Name @(l.VariantInfo != null ? "(" + l.VariantInfo + ")" : "") × @l.Quantity</span>
			<span>₹@l.LineTotal.ToString("N0")</span>
		</div>
	}

	<hr>
	<div class="d-flex justify-content-between mb-2"><span>MRP</span><span>₹@Model.Mrp.ToString("N0")</span></div>
	@if (Model.Savings > 0)
	{
		<div class="d-flex justify-content-between mb-2"><span>Discount</span><span class="text-success">− ₹@Model.Savings.ToString("N0")</span></div>
	}
	<div class="d-flex justify-content-between mb-2"><span>Delivery</span><span class="text-success">Free</span></div>
	<hr>
	<div class="d-flex justify-content-between fs-5"><strong>Total payable</strong><strong>₹@Model.Total.ToString("N0")</strong></div>
</div>
